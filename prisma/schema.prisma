datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SkillRank {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
  SAINT
  KING
  EMPEROR
  GOD
}

enum AdventurerRank {
  F
  E
  D
  C
  B
  A
  S
}

enum ActionType {
  TRAINING
  TRAVEL
  QUEST
  REST
}

enum EquipmentSlot {
  CLOTHING
  BOOTS
  GLOVES
  RIGHT_HAND
  LEFT_HAND
  TALISMAN_1
  TALISMAN_2
  TALISMAN_3
  TALISMAN_4
}

model Server {
  id     String @id @map("server_id")
  prefix String @default("!")

  @@map("servers")
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  username  String
  createdAt DateTime @default(now()) @map("created_at")

  // Position coordinates
  positionX Int @default(0) @map("position_x")
  positionY Int @default(0) @map("position_y")

  linkedAccounts LinkedAccount[]

  currentHp Int @default(500) @map("current_hp")
  maxHp     Int @default(500) @map("max_hp")

  currentStamina Int @default(500) @map("current_stamina")
  maxStamina     Int @default(500) @map("max_stamina")
  staminaXp      Int @default(0) @map("stamina_xp")

  currentMana Int @default(1000) @map("current_mana")
  maxMana     Int @default(1000) @map("max_mana")
  manaXp      Int @default(0) @map("mana_xp")

  lastRegenUpdate DateTime @default(now()) @map("last_regen_update")

  adventurerRank AdventurerRank @default(F) @map("adventurer_rank")

  clearedF Int @default(0) @map("cleared_adventurer_lower")
  clearedE Int @default(0) @map("cleared_adventurer_current")

  consecutiveFailuresLower   Int @default(0) @map("consecutive_failures_lower")
  consecutiveFailuresCurrent Int @default(0) @map("consecutive_failures_current")

  currentAction UserAction?

  clothingItemId   String?
  bootsItemId      String?
  glovesItemId     String?
  rightHandItemId  String?
  leftHandItemId   String?
  talisman1ItemId  String?
  talisman2ItemId  String?
  talisman3ItemId  String?
  talisman4ItemId  String?
  inventory        InventoryItem[]

  marketplaceListings MarketplaceListing[]

  swordsman SwordsmanClass?
  mage      MageClass?

  partyId    Int?   @map("party_id")
  party      Party? @relation("PartyMembers", fields: [partyId], references: [id], onDelete: SetNull)
  partyRoles Int    @default(0) @map("party_roles")

  ledParty Party? @relation("PartyLeader")

  @@map("user_profiles")
}

model UserAction {
  id        Int         @id @default(autoincrement())
  profileId Int         @unique @map("profile_id")
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type      ActionType
  startedAt DateTime   @default(now()) @map("started_at")
  duration  Int

  data Json?

  @@map("user_actions")
}

model Party {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  leaderId Int         @unique @map("leader_id")
  leader   UserProfile @relation("PartyLeader", fields: [leaderId], references: [id], onDelete: Cascade)

  members     UserProfile[] @relation("PartyMembers")
  boardQuests BoardQuest[]

  @@map("parties")
}

model InventoryItem {
  id        Int         @id @default(autoincrement())
  profileId Int
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  itemId    String
  amount    Int         @default(1)
  slotIndex Int?

  @@unique([profileId, slotIndex])
  @@index([profileId])
  @@map("inventory_items")
}

model LinkedAccount {
  id             Int    @id @default(autoincrement())
  platform       String
  platformUserId String @map("platform_user_id")
  serverId       String @default("0") @map("server_id")

  profileId Int         @map("profile_id")
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([platform, platformUserId, serverId])
  @@map("linked_accounts")
}

model SwordsmanClass {
  id        Int         @id @default(autoincrement())
  profileId Int         @unique @map("profile_id")
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  swordGod SkillRank @default(NONE) @map("sword_god")
  northGod SkillRank @default(NONE) @map("north_god")
  waterGod SkillRank @default(NONE) @map("water_god")

  @@map("swordsman_classes")
}

model MageClass {
  id        Int         @id @default(autoincrement())
  profileId Int         @unique @map("profile_id")
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fire           SkillRank @default(NONE)
  water          SkillRank @default(NONE)
  wind           SkillRank @default(NONE)
  earth          SkillRank @default(NONE)
  healing        SkillRank @default(NONE)
  detoxification SkillRank @default(NONE)
  protection     SkillRank @default(NONE)
  summoning      SkillRank @default(NONE)

  @@map("mage_classes")
}

enum BoardQuestStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  EXPIRED
  FAILED
}

model City {
  id          String   @id // ex: "city_sharia"
  name        String
  positionX   Int      @map("position_x")
  positionY   Int      @map("position_y")
  kingdom     String
  race        String
  climate     String
  description String
  dangerLevel String   @default("LOW") @map("danger_level")

  shops       Shop[]
  questBoards QuestBoard[]

  @@map("cities")
}

model QuestBoard {
  id                   Int          @id @default(autoincrement())
  slug                 String       @unique
  name                 String

  cityId               String       @map("city_id")
  city                 City         @relation(fields: [cityId], references: [id], onDelete: Cascade)

  maxCapacity          Int          @default(50) @map("max_capacity")
  maxRank              String       @default("S") @map("max_rank")
  difficultyMultiplier Float        @default(1.0) @map("difficulty_multiplier")
  quests               BoardQuest[]

  @@map("quest_boards")
}

model BoardQuest {
  id              Int              @id @default(autoincrement())
  questTemplateId String?          @map("quest_template_id")
  title           String
  rank            String
  description     String
  durationMinutes Int              @map("duration_minutes")

  globalPositionX Int              @map("global_position_x")
  globalPositionY Int              @map("global_position_y")

  difficulty      Float
  xpReward        Int              @map("xp_reward")
  itemRewardsJson String           @map("item_rewards_json")
  isNull          Boolean          @default(false) @map("is_null")

  status          BoardQuestStatus @default(AVAILABLE)
  createdAt       DateTime         @default(now()) @map("created_at")
  expiresAt       DateTime         @map("expires_at")
  takenAt         DateTime?        @map("taken_at")
  partyId         Int?             @map("party_id")

  boardId         Int              @map("board_id")
  board           QuestBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  party           Party?           @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@map("board_quests")
}

model Shop {
  id        Int                  @id @default(autoincrement())
  slug      String               @unique
  name      String

  cityId    String               @map("city_id")
  city      City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)

  items     ShopItem[]
  listings  MarketplaceListing[]

  @@map("shops")
}

model ShopItem {
  id     Int    @id @default(autoincrement())
  shopId Int    @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  itemId String @map("item_id")
  price  Int

  @@map("shop_items")
}

model MarketplaceListing {
  id              Int         @id @default(autoincrement())
  shopId          Int         @map("shop_id")
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  sellerProfileId Int         @map("seller_profile_id")
  sellerProfile   UserProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  itemId    String            @map("item_id")
  price     Int
  amount    Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at")
  expiresAt DateTime          @map("expires_at")

  @@map("marketplace_listings")
}